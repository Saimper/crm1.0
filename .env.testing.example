# Copiar a `.env.testing` y rellenar APP_KEY y las credenciales locales.
#
# Este fichero existe por un incidente: `php artisan <lo-que-sea> --env=testing`
# carga `.env.testing`, y cuando NO existe Laravel se queda con `.env` — que
# apunta a la base de DESARROLLO. Un `migrate:fresh --env=testing` creyendo
# apuntar a la base de pruebas destruyó la base local completa.
#
# `phpunit.xml` sí fija DB_DATABASE=crm_test, así que la suite por PHPUnit
# siempre fue segura. El agujero es específicamente `artisan --env=testing`.

APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=crm_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
